# Copy to nexus/terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is git-ignored.

# ── Required ──────────────────────────────────────────────────────────────────
admin_password        = "Ch@ngeMe123!"       # must match the password set in infra/
state_storage_account = "sttfstate<suffix>"  # same storage account as infra/backend.hcl

