# Copy to infra/backend.hcl — NEVER commit backend.hcl (git-ignored).
#
# Run scripts/create-backend.sh once to provision the storage account and
# generate this file automatically, then initialise Terraform with:
#
#   terraform init -backend-config=backend.hcl

resource_group_name  = "rg-terraform-state"
storage_account_name = "sttfstateukhtbs01"
container_name       = "terraform-nexus-oss-azure"
key                  = "dev/infra.tfstate"
