terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/
*.tfvars
!terraform.tfvars.example

# Remote state backend config (deployment-specific — generated by scripts/create-backend.sh)
backend.hcl

# Bootstrap artefacts (may contain secrets)
.tmp/
.admin_access_token
*.token

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

CLAUDE.md
tasks/
