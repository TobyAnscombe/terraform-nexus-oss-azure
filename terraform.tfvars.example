# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is git-ignored.

# ── Required ──────────────────────────────────────────────────────────────────
admin_password = "Ch@ngeMe123!"   # min 8 chars

# ── Resource placement ────────────────────────────────────────────────────────
resource_group_name = "rg-nexus-oss"
location            = "uksouth"   # uksouth | southcentralus | brazilsouth | etc.
environment         = "prod"      # dev | staging | prod

# ── Container sizing ──────────────────────────────────────────────────────────
# Nexus 3 minimum: 1 vCPU / 4 GB.  Recommended for production: 4 vCPU / 8 GB.
nexus_cpu       = 2
nexus_memory_gb = 4

# ── Storage ───────────────────────────────────────────────────────────────────
storage_replication_type  = "LRS"
nexus_data_share_quota_gb = 100

# ── Networking ────────────────────────────────────────────────────────────────
dns_name_label_prefix = "nexus-oss"

# Option A — Public (default): internet-accessible, Azure-assigned DNS label
vnet_integrated    = false
nsg_inbound_source = "*"

# Option B — Managed private VNet: ACI deployed into a new VNet + subnet
# vnet_integrated    = true
# nsg_inbound_source = "10.0.0.0/8"  # your corporate / VPN CIDR

# Option C — Existing subnet: attach to a subnet in an existing VNet/hub
# The subnet must already be delegated to Microsoft.ContainerInstance/containerGroups.
# vnet_integrated and nsg_inbound_source are ignored when existing_subnet_id is set.
# existing_subnet_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-hub/providers/Microsoft.Network/virtualNetworks/vnet-hub/subnets/snet-nexus"

# ── Optional tags ─────────────────────────────────────────────────────────────
tags = {
  owner   = "devops-team"
  project = "internal-pypi"
}
