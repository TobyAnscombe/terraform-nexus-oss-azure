# Copy to infra/terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is git-ignored.
#
# Nexus credentials and allowlists are configured in nexus/terraform.tfvars.

# ── Resource placement ────────────────────────────────────────────────────────
resource_group_name = "rg-nexus-oss"
location            = "uksouth"   # uksouth | southcentralus | brazilsouth | etc.
environment         = "prod"      # dev | staging | prod

# ── Container sizing ──────────────────────────────────────────────────────────
# Nexus 3 minimum: 1 vCPU / 4 GB.  Recommended for production: 4 vCPU / 8 GB.
nexus_cpu       = 2
nexus_memory_gb = 4

# ── Storage ───────────────────────────────────────────────────────────────────
storage_replication_type  = "LRS"
nexus_data_share_quota_gb = 100

# ── VNet ──────────────────────────────────────────────────────────────────────
# ACI is always deployed with a private IP — no public IP or DNS label.
vnet_address_space = "10.100.0.0/16"
aci_subnet_prefix  = "10.100.1.0/24"

# ── Storage network access (optional) ────────────────────────────────────────
# Subnets outside this deployment that should reach the Nexus file share
# (e.g. a shared services VNet, dev workstation subnet, or peered VNet).
# Each subnet must have the Microsoft.Storage service endpoint enabled.
# additional_storage_subnet_ids = [
#   "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>",
# ]

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# 1. In Zero Trust dashboard → Networks → Tunnels → Create a tunnel (Cloudflared).
# 2. Under Public Hostnames, add:  <hostname>  →  http://localhost:8081
# 3. Copy the tunnel token and paste it below (sensitive — never commit).
cloudflare_tunnel_token    = "eyJ..."
cloudflare_tunnel_hostname = "nexus.example.com"

# ── Optional tags ─────────────────────────────────────────────────────────────
tags = {
  owner   = "devops-team"
  project = "internal-pypi"
}
